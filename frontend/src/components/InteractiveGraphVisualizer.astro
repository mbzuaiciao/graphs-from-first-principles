---
import { PREDEFINED_GRAPH } from '../lib/traversalEngine';

interface Props {
  initialAlgorithm?: 'bfs' | 'dfs';
  initialStartNode?: string;
}

const { initialAlgorithm = 'bfs', initialStartNode = 'A' } = Astro.props;
---

<div
  class="graph-visualizer-container"
  id="graphVisualizer"
  data-initial-algo={initialAlgorithm}
  data-initial-start={initialStartNode}
>
  <!-- Control Header -->
  <div class="visualizer-header">
    <div class="algorithm-toggle-wrap">
      <div class="segmented-control" role="tablist" aria-label="Traversal Algorithm">
        <button
          type="button"
          class="algo-btn active"
          data-algo="bfs"
          role="tab"
          aria-selected="true"
          id="tab-bfs"
        >
          Breadth-First (Queue)
        </button>
        <button
          type="button"
          class="algo-btn"
          data-algo="dfs"
          role="tab"
          aria-selected="false"
          id="tab-dfs"
        >
          Depth-First (Stack)
        </button>
      </div>
    </div>

    <!-- Playback Controls -->
    <div class="playback-controls">
      <button type="button" class="ctrl-btn" id="btnPrev" title="Previous Step (Left Arrow)" aria-label="Previous Step">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="ctrl-btn primary" id="btnPlayPause" title="Play / Pause (Space)" aria-label="Play or Pause">
        <span id="playIcon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </span>
        <span id="pauseIcon" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
        </span>
      </button>

      <button type="button" class="ctrl-btn" id="btnNext" title="Next Step (Right Arrow)" aria-label="Next Step">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <button type="button" class="ctrl-btn" id="btnReset" title="Reset Traversal (R)" aria-label="Reset Traversal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>

      <div class="speed-select-wrap">
        <label for="speedSelect" class="sr-only">Playback Speed</label>
        <select id="speedSelect" class="speed-select" aria-label="Playback Speed">
          <option value="1200">0.75x</option>
          <option value="800" selected>1.0x</option>
          <option value="400">1.5x</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Main Canvas & Inspector Layout -->
  <div class="visualizer-body">
    <!-- SVG Graph Canvas -->
    <div class="canvas-wrap">
      <svg
        id="graphSvg"
        viewBox="0 0 640 370"
        class="graph-svg"
        role="img"
        aria-label="Interactive Graph Diagram"
      >
        <!-- Edges layer -->
        <g id="edgesLayer">
          {PREDEFINED_GRAPH.edges.map((e) => {
            const uNode = PREDEFINED_GRAPH.nodes.find((n) => n.id === e.u)!;
            const vNode = PREDEFINED_GRAPH.nodes.find((n) => n.id === e.v)!;
            const edgeKey = `${e.u}-${e.v}`;
            return (
              <line
                id={`edge-${edgeKey}`}
                data-u={e.u}
                data-v={e.v}
                x1={uNode.x}
                y1={uNode.y}
                x2={vNode.x}
                y2={vNode.y}
                class="graph-edge"
              />
            );
          })}
        </g>

        <!-- Nodes layer -->
        <g id="nodesLayer">
          {PREDEFINED_GRAPH.nodes.map((n) => (
            <g id={`node-group-${n.id}`} class="node-group" transform={`translate(${n.x}, ${n.y})`}>
              <!-- Halo ring for current node -->
              <circle id={`halo-${n.id}`} r="26" class="node-halo" />
              <!-- Core node circle -->
              <circle id={`node-${n.id}`} r="20" class="node-circle" />
              <!-- Node label -->
              <text id={`label-${n.id}`} y="6" text-anchor="middle" class="node-text">
                {n.label}
              </text>
            </g>
          ))}
        </g>
      </svg>

      <!-- Graph Legend -->
      <div class="graph-legend">
        <div class="legend-item"><span class="legend-swatch current"></span> Current</div>
        <div class="legend-item"><span class="legend-swatch frontier"></span> Frontier</div>
        <div class="legend-item"><span class="legend-swatch visited"></span> Visited</div>
        <div class="legend-item"><span class="legend-swatch default"></span> Unvisited</div>
      </div>
    </div>

    <!-- Inspector Panel -->
    <div class="inspector-panel">
      <!-- Progress Bar & Step Counter -->
      <div class="progress-section">
        <div class="progress-info">
          <span class="step-label" id="stepCounter">Step 0 of 0</span>
          <span class="status-badge" id="statusBadge">Ready</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Action Box -->
      <div class="action-card" aria-live="polite">
        <h4 class="action-title" id="actionTitle">Initialize Traversal</h4>
        <p class="action-desc" id="actionDesc">Select an algorithm and click Next Step or Play to begin.</p>
      </div>

      <!-- Frontier Inspector (Stack or Queue) -->
      <div class="frontier-card">
        <div class="frontier-header">
          <h5 id="frontierLabel">Queue (FIFO)</h5>
          <span class="frontier-dir-hint" id="frontierHint">Front &rarr; Back</span>
        </div>
        <div class="frontier-items-wrap" id="frontierItems">
          <span class="empty-frontier-msg">Empty</span>
        </div>
      </div>

      <!-- Visited History Inspector -->
      <div class="visited-card">
        <div class="visited-header">
          <h5>Visited Set (Order of Discovery)</h5>
          <span class="visited-count" id="visitedCount">0 nodes</span>
        </div>
        <div class="visited-chips-wrap" id="visitedChips">
          <span class="empty-frontier-msg">None</span>
        </div>
      </div>

      <!-- Keyboard Shortcuts Hint -->
      <div class="keyboard-shortcuts-hint">
        <span class="key-badge">Space</span> Play
        <span class="key-badge">&rarr;</span> Next
        <span class="key-badge">&larr;</span> Prev
        <span class="key-badge">R</span> Reset
      </div>
    </div>
  </div>
</div>

<style>
  .graph-visualizer-container {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin: 2rem 0;
  }

  .visualizer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.4rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-light);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .playback-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ctrl-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    color: var(--text-primary);
    box-shadow: var(--shadow-subtle);
    transition: all 0.15s ease;
  }

  .ctrl-btn:hover {
    background: #ffffff;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
    color: var(--accent-blue);
  }

  .ctrl-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .ctrl-btn.primary {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }

  .ctrl-btn.primary:hover {
    background: var(--accent-blue-hover);
  }

  .speed-select {
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    padding: 6px 10px;
    outline: none;
    box-shadow: var(--shadow-subtle);
  }

  .visualizer-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    min-height: 400px;
  }

  /* Canvas area */
  .canvas-wrap {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--border-light);
    background: #ffffff;
    position: relative;
  }

  .graph-svg {
    width: 100%;
    height: auto;
    max-height: 340px;
  }

  /* SVG elements */
  .graph-edge {
    stroke: #d2d2d7;
    stroke-width: 2.2;
    transition: stroke 0.3s ease, stroke-width 0.3s ease;
  }

  .graph-edge.active {
    stroke: var(--accent-blue);
    stroke-width: 3.5;
  }

  .node-group {
    cursor: pointer;
  }

  .node-halo {
    fill: none;
    stroke: var(--accent-blue);
    stroke-width: 3;
    opacity: 0;
    transform-origin: center;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .node-group.current .node-halo {
    opacity: 0.6;
    animation: pulseRing 1.8s infinite;
  }

  @keyframes pulseRing {
    0% { transform: scale(0.92); opacity: 0.8; }
    50% { transform: scale(1.08); opacity: 0.2; }
    100% { transform: scale(0.92); opacity: 0.8; }
  }

  .node-circle {
    fill: #ffffff;
    stroke: #86868b;
    stroke-width: 2;
    transition: fill 0.25s ease, stroke 0.25s ease;
  }

  .node-text {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    fill: #1d1d1f;
    pointer-events: none;
    transition: fill 0.25s ease;
  }

  /* Node state styles */
  .node-group.current .node-circle {
    fill: var(--accent-blue);
    stroke: var(--accent-blue);
  }

  .node-group.current .node-text {
    fill: #ffffff;
  }

  .node-group.frontier .node-circle {
    fill: var(--accent-orange-soft);
    stroke: var(--accent-orange);
    stroke-width: 2.5;
  }

  .node-group.frontier .node-text {
    fill: var(--accent-orange);
  }

  .node-group.visited .node-circle {
    fill: var(--accent-green-soft);
    stroke: var(--accent-green);
    stroke-width: 2.2;
  }

  .node-group.visited .node-text {
    fill: #1d1d1f;
  }

  /* Legend */
  .graph-legend {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .legend-swatch.current { background: var(--accent-blue); }
  .legend-swatch.frontier { background: var(--accent-orange-soft); border: 2px solid var(--accent-orange); }
  .legend-swatch.visited { background: var(--accent-green-soft); border: 2px solid var(--accent-green); }
  .legend-swatch.default { background: #ffffff; border: 2px solid #86868b; }

  /* Inspector Panel */
  .inspector-panel {
    padding: 1.4rem;
    background: var(--bg-tertiary);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .progress-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .step-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--bg-secondary);
    color: var(--text-secondary);
  }

  .status-badge.active {
    background: var(--accent-blue-soft);
    color: var(--accent-blue);
  }

  .status-badge.complete {
    background: var(--accent-green-soft);
    color: var(--accent-green);
  }

  .progress-track {
    height: 4px;
    background: var(--border-light);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent-blue);
    transition: width 0.25s ease;
  }

  .action-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem;
    box-shadow: var(--shadow-subtle);
  }

  .action-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .action-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .frontier-card, .visited-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.9rem;
    box-shadow: var(--shadow-subtle);
  }

  .frontier-header, .visited-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }

  .frontier-header h5, .visited-header h5 {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .frontier-dir-hint, .visited-count {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  .frontier-items-wrap {
    display: flex;
    gap: 6px;
    min-height: 34px;
    align-items: center;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .frontier-item {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: var(--accent-orange-soft);
    color: var(--accent-orange);
    border: 1px solid rgba(255, 149, 0, 0.35);
    display: inline-flex;
    align-items: center;
  }

  .visited-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    min-height: 28px;
    align-items: center;
  }

  .visited-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--accent-green-soft);
    color: #1e7f43;
    border: 1px solid rgba(52, 199, 89, 0.3);
  }

  .empty-frontier-msg {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  .keyboard-shortcuts-hint {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: auto;
    padding-top: 6px;
  }

  .key-badge {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-right: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 900px) {
    .visualizer-body {
      grid-template-columns: 1fr;
    }
    .canvas-wrap {
      border-right: none;
      border-bottom: 1px solid var(--border-light);
    }
  }
</style>

<script>
  import { PREDEFINED_GRAPH, generateBFSSteps, generateDFSSteps, type TraversalStep } from '../lib/traversalEngine';

  function initVisualizer() {
    const root = document.getElementById('graphVisualizer');
    if (!root) return;

    let currentAlgo: 'bfs' | 'dfs' = (root.getAttribute('data-initial-algo') as 'bfs' | 'dfs') || 'bfs';
    let currentStepIndex = 0;
    let isPlaying = false;
    let timerId: number | null = null;
    let playSpeed = 800;

    let steps: TraversalStep[] = currentAlgo === 'bfs'
      ? generateBFSSteps(PREDEFINED_GRAPH, 'A')
      : generateDFSSteps(PREDEFINED_GRAPH, 'A');

    // DOM Elements
    const tabBfs = document.getElementById('tab-bfs') as HTMLButtonElement;
    const tabDfs = document.getElementById('tab-dfs') as HTMLButtonElement;
    const btnPrev = document.getElementById('btnPrev') as HTMLButtonElement;
    const btnNext = document.getElementById('btnNext') as HTMLButtonElement;
    const btnPlayPause = document.getElementById('btnPlayPause') as HTMLButtonElement;
    const btnReset = document.getElementById('btnReset') as HTMLButtonElement;
    const playIcon = document.getElementById('playIcon') as HTMLElement;
    const pauseIcon = document.getElementById('pauseIcon') as HTMLElement;
    const speedSelect = document.getElementById('speedSelect') as HTMLSelectElement;

    const stepCounter = document.getElementById('stepCounter') as HTMLElement;
    const statusBadge = document.getElementById('statusBadge') as HTMLElement;
    const progressFill = document.getElementById('progressFill') as HTMLElement;
    const actionTitle = document.getElementById('actionTitle') as HTMLElement;
    const actionDesc = document.getElementById('actionDesc') as HTMLElement;
    const frontierLabel = document.getElementById('frontierLabel') as HTMLElement;
    const frontierHint = document.getElementById('frontierHint') as HTMLElement;
    const frontierItems = document.getElementById('frontierItems') as HTMLElement;
    const visitedChips = document.getElementById('visitedChips') as HTMLElement;
    const visitedCount = document.getElementById('visitedCount') as HTMLElement;

    function renderStep(idx: number) {
      if (idx < 0) idx = 0;
      if (idx >= steps.length) idx = steps.length - 1;
      currentStepIndex = idx;
      const step = steps[idx];

      // Update progress & badges
      stepCounter.textContent = `Step ${step.stepIndex} of ${step.totalSteps - 1}`;
      const pct = Math.round((step.stepIndex / (step.totalSteps - 1)) * 100);
      progressFill.style.width = `${pct}%`;

      if (step.isComplete) {
        statusBadge.textContent = 'Completed';
        statusBadge.className = 'status-badge complete';
        pause();
      } else if (step.stepIndex === 0) {
        statusBadge.textContent = 'Ready';
        statusBadge.className = 'status-badge';
      } else {
        statusBadge.textContent = 'Running';
        statusBadge.className = 'status-badge active';
      }

      // Update text descriptions
      actionTitle.textContent = step.actionTitle;
      actionDesc.textContent = step.actionExplanation;

      // Update Frontier Card
      if (step.frontierType === 'queue') {
        frontierLabel.textContent = 'Queue (FIFO)';
        frontierHint.textContent = 'Front → Back';
      } else {
        frontierLabel.textContent = 'Stack (LIFO)';
        frontierHint.textContent = 'Bottom → Top';
      }

      if (step.frontier.length === 0) {
        frontierItems.innerHTML = '<span class="empty-frontier-msg">Empty</span>';
      } else {
        frontierItems.innerHTML = step.frontier
          .map((item, i) => {
            const isTopOrFront = (step.frontierType === 'queue' && i === 0) ||
                                 (step.frontierType === 'stack' && i === step.frontier.length - 1);
            const tag = isTopOrFront ? (step.frontierType === 'queue' ? ' (front)' : ' (top)') : '';
            return `<span class="frontier-item">${item}${tag}</span>`;
          })
          .join('');
      }

      // Update Visited Chips
      if (step.visited.length === 0) {
        visitedChips.innerHTML = '<span class="empty-frontier-msg">None</span>';
        visitedCount.textContent = '0 nodes';
      } else {
        visitedChips.innerHTML = step.visited
          .map((v) => `<span class="visited-chip">${v}</span>`)
          .join('');
        visitedCount.textContent = `${step.visited.length} node${step.visited.length > 1 ? 's' : ''}`;
      }

      // Update SVG node classes
      PREDEFINED_GRAPH.nodes.forEach((n) => {
        const group = document.getElementById(`node-group-${n.id}`);
        if (!group) return;
        group.classList.remove('current', 'frontier', 'visited');

        if (step.currentNode === n.id) {
          group.classList.add('current');
        } else if (step.frontier.includes(n.id)) {
          group.classList.add('frontier');
        } else if (step.visited.includes(n.id)) {
          group.classList.add('visited');
        }
      });

      // Update SVG edge classes
      PREDEFINED_GRAPH.edges.forEach((e) => {
        const line = document.getElementById(`edge-${e.u}-${e.v}`);
        if (!line) return;
        line.classList.remove('active');

        if (step.highlightedEdge) {
          const [u, v] = step.highlightedEdge;
          if ((e.u === u && e.v === v) || (e.u === v && e.v === u)) {
            line.classList.add('active');
          }
        }
      });

      // Update button states
      btnPrev.disabled = currentStepIndex === 0;
      btnNext.disabled = currentStepIndex >= steps.length - 1;
    }

    function switchAlgorithm(algo: 'bfs' | 'dfs') {
      pause();
      currentAlgo = algo;
      if (algo === 'bfs') {
        tabBfs.classList.add('active');
        tabBfs.setAttribute('aria-selected', 'true');
        tabDfs.classList.remove('active');
        tabDfs.setAttribute('aria-selected', 'false');
        steps = generateBFSSteps(PREDEFINED_GRAPH, 'A');
      } else {
        tabDfs.classList.add('active');
        tabDfs.setAttribute('aria-selected', 'true');
        tabBfs.classList.remove('active');
        tabBfs.setAttribute('aria-selected', 'false');
        steps = generateDFSSteps(PREDEFINED_GRAPH, 'A');
      }
      renderStep(0);
    }

    function play() {
      if (currentStepIndex >= steps.length - 1) {
        currentStepIndex = 0;
      }
      isPlaying = true;
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'inline-block';

      timerId = window.setInterval(() => {
        if (currentStepIndex < steps.length - 1) {
          renderStep(currentStepIndex + 1);
        } else {
          pause();
        }
      }, playSpeed);
    }

    function pause() {
      isPlaying = false;
      playIcon.style.display = 'inline-block';
      pauseIcon.style.display = 'none';
      if (timerId !== null) {
        clearInterval(timerId);
        timerId = null;
      }
    }

    function togglePlay() {
      if (isPlaying) {
        pause();
      } else {
        play();
      }
    }

    // Attach Event Listeners
    tabBfs?.addEventListener('click', () => switchAlgorithm('bfs'));
    tabDfs?.addEventListener('click', () => switchAlgorithm('dfs'));

    btnNext?.addEventListener('click', () => {
      pause();
      if (currentStepIndex < steps.length - 1) {
        renderStep(currentStepIndex + 1);
      }
    });

    btnPrev?.addEventListener('click', () => {
      pause();
      if (currentStepIndex > 0) {
        renderStep(currentStepIndex - 1);
      }
    });

    btnReset?.addEventListener('click', () => {
      pause();
      renderStep(0);
    });

    btnPlayPause?.addEventListener('click', togglePlay);

    speedSelect?.addEventListener('change', (e) => {
      playSpeed = parseInt((e.target as HTMLSelectElement).value, 10);
      if (isPlaying) {
        pause();
        play();
      }
    });

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      // Ignore if user is typing in an input
      if (['INPUT', 'SELECT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;

      if (e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        pause();
        if (currentStepIndex < steps.length - 1) renderStep(currentStepIndex + 1);
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        pause();
        if (currentStepIndex > 0) renderStep(currentStepIndex - 1);
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        pause();
        renderStep(0);
      }
    });

    // Initial render
    renderStep(0);
  }

  // Support both DOMContentLoaded and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVisualizer);
  } else {
    initVisualizer();
  }
  document.addEventListener('astro:page-load', initVisualizer);
</script>
