---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="header-inner">
    <a href={`${base}/`} class="brand-link">
      <svg class="brand-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="6" cy="6" r="3"></circle>
        <circle cx="18" cy="6" r="3"></circle>
        <circle cx="12" cy="18" r="3"></circle>
        <line x1="8.5" y1="7.5" x2="10" y2="16"></line>
        <line x1="15.5" y1="7.5" x2="14" y2="16"></line>
        <line x1="9" y1="6" x2="15" y2="6"></line>
      </svg>
      <span class="brand-title">Graphs</span>
      <span class="brand-subtitle">From First Principles</span>
    </a>

    <nav class="nav-links">
      <a href={`${base}/`} class:list={['nav-item', { active: currentPath === '' || currentPath === '/' }]}>
        Overview
      </a>
      <a
        href={`${base}/tutorials/01-foundations-trees-to-graphs/`}
        class:list={['nav-item', { active: currentPath.includes('/tutorials') }]}
      >
        Chapters
      </a>
      <a
        href={`${base}/visualizer/`}
        class:list={['nav-item', 'nav-pill', { active: currentPath.includes('/visualizer') }]}
      >
        <span class="pulse-dot"></span>
        Interactive Lab
      </a>
      <a
        href="https://github.com/mbzuaiciao/graphs-from-first-principles"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-icon-link"
        aria-label="GitHub Repository"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-light);
    height: 52px;
    display: flex;
    align-items: center;
  }

  .header-inner {
    width: 100%;
    max-width: var(--max-page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .brand-icon {
    color: var(--accent-blue);
  }

  .brand-title {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-subtitle {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 400;
    border-left: 1px solid var(--border-subtle);
    padding-left: 8px;
    margin-left: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .nav-item {
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .nav-item.active {
    color: var(--accent-blue);
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--accent-blue-soft);
    color: var(--accent-blue) !important;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-blue);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 113, 227, 0.6); }
    70% { transform: scale(1); box-shadow: 0 0 0 5px rgba(0, 113, 227, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 113, 227, 0); }
  }

  .nav-icon-link {
    color: var(--text-tertiary);
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }

  .nav-icon-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .brand-subtitle {
      display: none;
    }
    .nav-links {
      gap: 0.8rem;
    }
  }
</style>
