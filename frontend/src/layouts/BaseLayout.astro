---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'An Apple-inspired interactive textbook on graph data structures, traversals, and complexity from first principles.',
  currentPath = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Graphs from First Principles</title>
    <!-- KaTeX CSS for mathematical formulas -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <Header currentPath={currentPath} />

    <main class="page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="footer-title">Graphs from First Principles</span>
            <p class="footer-desc">
              An accessible, rigorous interactive visual textbook exploring graph data structures,
              traversals, and algorithmic complexity.
            </p>
          </div>
          <div class="footer-links-col">
            <h6>Curriculum</h6>
            <a href={`${base}/tutorials/01-foundations-trees-to-graphs/`}>Foundations</a>
            <a href={`${base}/tutorials/04-depth-first-search/`}>Depth-First Search</a>
            <a href={`${base}/tutorials/05-breadth-first-search-and-shortest-paths/`}>Breadth-First Search</a>
            <a href={`${base}/tutorials/07-complexity-analysis-first-principles/`}>Complexity</a>
          </div>
          <div class="footer-links-col">
            <h6>Interactive Lab</h6>
            <a href={`${base}/visualizer/`}>Traversal Simulator</a>
            <a href="https://github.com/mbzuaiciao/graphs-from-first-principles" target="_blank" rel="noopener noreferrer">
              GitHub Source
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-attribution">
            Inspired by the topic guide in Paaras Chand's course presentation on
            <a href="https://paaras.github.io/python_ds/graphs#1" target="_blank" rel="noopener noreferrer">
              Graphs
            </a>. Original educational material authored from first principles.
          </p>
          <p class="footer-copy">MIT Licensed.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .page-main {
    flex: 1;
  }

  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-light);
    margin-top: 5rem;
    padding: 3rem 1.5rem 2rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .footer-inner {
    max-width: var(--max-page-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }

  .footer-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .footer-desc {
    margin-top: 0.5rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links-col h6 {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin-bottom: 0.3rem;
  }

  .footer-links-col a {
    color: var(--text-secondary);
    font-size: 0.84rem;
  }

  .footer-links-col a:hover {
    color: var(--accent-blue);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-attribution a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
